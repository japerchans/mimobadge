# With no DATABASE_URL, local development uses .data/workspace.json (fictional demo only).
# DATABASE_URL=postgresql://mimo:mimo@localhost:5432/mimobadge
# Required for a production start. Generate a long random secret.
SESSION_SECRET=
# Shared prototype login; replace with facility identity provider before real use.
DEMO_ACCESS_CODE=
# Set the public HTTPS origin when running behind a reverse proxy.
# APP_ORIGIN=https://care.example.com
# Server-only OpenAI credentials. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
